<?xml version="1.0" encoding="utf-8"?>
<!-- 当前目标所在行的底：淡绿底 + 按压涟漪（与普通行的纯深色底区分，
     配合右侧实心绿「✓ 当前」胶囊，扫视时一眼能定位） -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/m3_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_sec_container" />
            <stroke android:width="1dp" android:color="@color/q4_action_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
